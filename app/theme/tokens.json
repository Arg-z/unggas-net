{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Unggas.net UI v5 — kertas berbingkai. Sumber kebenaran kelas tetap src/app/globals.css (@theme Tailwind v4); berkas ini ringkasan untuk alat desain.",
  "color": {
    "$type": "color",
    "ground": { "$value": "#edf2ea" },
    "surface": { "$value": "#ffffff" },
    "raised": { "$value": "#fbfdfb" },
    "wash": { "$value": "#f3f8f1" },
    "sunken": { "$value": "#e8eee5" },
    "border": { "$value": "#dfe6dc" },
    "rule": { "$value": "#eef2ec" },
    "control": { "$value": "#7d8d79" },
    "ink": { "$value": "#1b2621" },
    "ink-strong": { "$value": "#0f1714" },
    "ink-soft": { "$value": "#47524c" },
    "ink-faint": { "$value": "#5f6672" },
    "accent": { "$value": "#2e7d32" },
    "accent-deep": { "$value": "#236327" },
    "accent-ink": { "$value": "#1b5e20" },
    "accent-soft": { "$value": "#e8f5e9" },
    "accent-track": { "$value": "#c8e6c9" },
    "warn-soft": { "$value": "#fef3c7" },
    "warn-line": { "$value": "#fde68a" },
    "warn-ink": { "$value": "#92400e" },
    "danger": { "$value": "#bf000f" },
    "danger-soft": { "$value": "#fdecec" },
    "danger-line": { "$value": "#f4c7c9" },
    "avatar": {
      "hijau": { "bg": { "$value": "#e8f5e9" }, "ink": { "$value": "#1b5e20" }, "line": { "$value": "#9ac59e" } },
      "amber": { "bg": { "$value": "#fef3c7" }, "ink": { "$value": "#92400e" }, "line": { "$value": "#e8b93a" } },
      "biru": { "bg": { "$value": "#e0f2fe" }, "ink": { "$value": "#075985" }, "line": { "$value": "#7cc7ee" } },
      "oranye": { "bg": { "$value": "#ffedd5" }, "ink": { "$value": "#9a3412" }, "line": { "$value": "#f5b473" } },
      "teal": { "bg": { "$value": "#ccfbf1" }, "ink": { "$value": "#115e59" }, "line": { "$value": "#42d3bb" } },
      "rose": { "bg": { "$value": "#ffe4e6" }, "ink": { "$value": "#9f1239" }, "line": { "$value": "#f9a6b0" } }
    }
  },
  "radius": {
    "$type": "dimension",
    "sheet": { "$value": { "value": 16, "unit": "px" } },
    "panel": { "$value": { "value": 12, "unit": "px" } },
    "control": { "$value": { "value": 8, "unit": "px" } },
    "chip": { "$value": { "value": 4, "unit": "px" } }
  },
  "space": {
    "$type": "dimension",
    "sheet-inset": { "$value": { "value": 8, "unit": "px" } },
    "sidebar": { "$value": { "value": 228, "unit": "px" } },
    "topbar": { "$value": { "value": 48, "unit": "px" } },
    "nav-bawah": { "$value": { "value": 54, "unit": "px" } },
    "content-x": { "$value": { "value": 28, "unit": "px" } },
    "row-y": { "$value": { "value": 14, "unit": "px" } }
  },
  "font": {
    "display": { "$value": "Fraunces, Georgia, 'Times New Roman', serif" },
    "body": { "$value": "'Plus Jakarta Sans', system-ui, sans-serif" }
  },
  "typography": {
    "h1": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "26px", "fontWeight": 600, "letterSpacing": "-0.02em" } },
    "h1-wide": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "30px", "fontWeight": 600, "letterSpacing": "-0.02em" } },
    "prose": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "17.5px", "fontWeight": 400, "lineHeight": 1.72 } },
    "row-title": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontSize": "15px", "fontWeight": 600, "lineHeight": 1.5 } },
    "meta": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.5 } },
    "label": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontSize": "13px", "fontWeight": 600 } }
  }
}
