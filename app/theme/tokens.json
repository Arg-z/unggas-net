{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Forum komunitas peternak unggas berbahasa Indonesia — hijau kebun di atas kertas putih, tenang, padat, mudah dipindai dari ponsel.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.18,
          0.49,
          0.196
        ],
        "hex": "#2e7d32"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.153,
          0.412,
          0.169
        ],
        "hex": "#27692b"
      }
    },
    "tint": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.961,
          0.914
        ],
        "hex": "#e8f5e9"
      }
    },
    "tint-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.784,
          0.902,
          0.788
        ],
        "hex": "#c8e6c9"
      }
    },
    "tint-text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.106,
          0.369,
          0.125
        ],
        "hex": "#1b5e20"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.118,
          0.161,
          0.224
        ],
        "hex": "#1e2939"
      }
    },
    "ink-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.063,
          0.094,
          0.157
        ],
        "hex": "#101828"
      }
    },
    "ink-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.29,
          0.333,
          0.396
        ],
        "hex": "#4a5565"
      }
    },
    "ink-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.416,
          0.447,
          0.51
        ],
        "hex": "#6a7282"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.953,
          0.957,
          0.965
        ],
        "hex": "#f3f4f6"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.82,
          0.835,
          0.863
        ],
        "hex": "#d1d5dc"
      }
    },
    "border-subtle": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.898,
          0.906,
          0.922
        ],
        "hex": "#e5e7eb"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.749,
          0,
          0.059
        ],
        "hex": "#bf000f"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xxl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "container": {
      "$value": {
        "value": 1024,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "md": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "font-stack": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label-xs": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    }
  }
}
